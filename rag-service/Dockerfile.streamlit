# Dockerfile para Streamlit
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=astral-sh/uv:0.10.8 /uv /usr/local/bin/uv

WORKDIR /app

# Copiar el pyproject.toml para instalar dependencias de la demo
COPY src/pyproject.toml .

RUN uv pip install --system -r pyproject.toml

# Copiar todo el servicio
COPY . .

# Exponer Streamlit
EXPOSE 8501

CMD ["streamlit", "run", "presentation/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
