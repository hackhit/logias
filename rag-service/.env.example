# Configuración básica de entorno para RAG Service
PORT=8000
DB_HOST=postgres
DB_PORT=5432
DB_USER=app_runtime
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
DB_NAME=rag_db

# Secreto JWT para Litestar
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY_MIN_32_CHARS

# Parámetros de mora
# FECHA_REFERENCIA_MORA=2026-03-01

# Modo Mock de LLM (true para desarrollo sin CPU/GGUF pesado)
# MOCK_LLM=true

# Ubicación del modelo GGUF (cuando MOCK_LLM=false)
MODEL_PATH=/app/models/llama-2-7b-chat.Q4_K_M.gguf

# Configuración Rate Limiter
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=5
